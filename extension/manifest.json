{
  "manifest_version": 3,
  "name": "Meikova Harvest Companion",
  "version": "1.1.0",
  "description": "Directly forwards media pages and streaming URLs to your local Meikova Harvest app with one click.",
  "permissions": [
    "activeTab",
    "cookies",
    "webNavigation",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to Meikova Harvest",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
