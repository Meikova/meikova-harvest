{
  "name": "everythingdownloader",
  "version": "2.0.3",
  "description": "EveryThingDownloader",
  "main": "main.js",
  "author": "m3iK18dp",
  "license": "MIT",
  "homepage": "https://github.com/m3iK18dp/EveryThingDownloader-Tool",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.1.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.everythingdownloader.app",
    "productName": "EveryThingDownloader",
    "compression": "normal",
    "directories": {
      "output": "../dist_electron"
    },
    "files": [
      "**/*",
      "!node_modules",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "server.exe",
          "server",
          "license.txt",
          "icon.png",
          "icon.ico"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        "dmg",
        "zip",
        "pkg"
      ],
      "icon": "resources/icon.png",
      "artifactName": "EveryThingDownloader-${version}-${arch}.${ext}"
    },
    "linux": {
      "maintainer": "EveryThingDownloader <contact@everythingdownloader.com>",
      "target": [
        "AppImage",
        "tar.gz",
        "deb",
        "rpm"
      ],
      "icon": "resources/icon.png",
      "category": "Utility",
      "artifactName": "EveryThingDownloader-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EveryThingDownloader",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeader": "resources/icon.ico",
      "license": "resources/license.txt",
      "artifactName": "EveryThingDownloader-Setup-${version}.exe"
    },
    "msi": {
      "artifactName": "EveryThingDownloader-${version}.msi"
    },
    "portable": {
      "artifactName": "EveryThingDownloader-Portable-${version}.exe"
    }
  }
}